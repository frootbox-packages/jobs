{#- A new job as a draft (decisions 0220, 0231). -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}

{% block title %}{{ t('New job') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            <p class="fb-muted"><a href="{{ path('frootbox.jobs.jobs') }}">{{ t('Jobs') }}</a></p>
            <h1 class="fb-heading-1">{{ t('New job') }}</h1>
        </div>
    </header>

    <fb-form action="frootbox/jobs/job.create" next="{{ path('frootbox.jobs.jobs') }}/{id}" done="{{ t('The job is saved as a draft.') }}">
        <form class="fb-card fb-card--padded fb-stack" novalidate>
            {% if space %}<input type="hidden" name="space" value="{{ space }}">{% endif %}
            {% include '@frootbox/jobs/backend/fields.twig' with {language: language, translation: null, slug: false, data: null, image: null, image_value: null, types: types, workplaces: workplaces, periods: periods, locations: locations, people: people, editable: true} only %}
            <div class="fb-form__actions">
                {{ ui.button({label: t('Save as a draft'), type: 'submit'}) }}
                {{ ui.button({label: t('Cancel'), variant: 'ghost', href: path('frootbox.jobs.jobs')}) }}
            </div>
        </form>
    </fb-form>
</div>
{% endblock %}
