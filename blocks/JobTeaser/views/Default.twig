{# frootbox
title: Newest jobs
description: The newest open jobs, e.g. on the start page, with a link to all of them.
group: teaser
keywords: [Jobs, Careers, Vacancies, Newest, Teasers]
options:
  space: { type: choice, label: Space, source: frootbox/jobs/space.choices, default: '' }
  count: { type: number, label: Number of jobs, default: 3, min: 1, max: 12 }
fields:
  title: { type: headline, label: Heading, optional: true, maxLength: 100, placeholder: "Jobs" }
#}
<div class="jobs-next">
  {{ heading('title', 0, {class: 'jobs-next__title'}) }}
  {% if jobs %}
    <ul class="jobs-next__items">
      {% for item in jobs %}
        <li class="jobs-next__item">
          {{ heading_text(item.title, 1, {class: 'jobs-next__name'}, item.url) }}
          <p class="jobs-next__facts">{{ ([item.types|map(type => t(type))|join(', '), item.location]|filter(fact => fact))|join(' · ') }}</p>
        </li>
      {% endfor %}
    </ul>
    {% if all %}<p class="jobs-next__all"><a href="{{ all }}">{{ t('All jobs') }}</a></p>{% endif %}
  {% else %}
    <p class="jobs-next__empty">{{ t('There are no open jobs right now.') }}</p>
  {% endif %}
</div>
